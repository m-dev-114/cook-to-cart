INSTAMART_MODE=local
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MIN=60
# Only for INSTAMART_MODE=swiggy (backend only, never commit):
# SWIGGY_MCP_URL=
# SWIGGY_MCP_TOKEN=
# Optional: AI extraction from YouTube transcripts (backend only). Also set a spend limit at the provider.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# LLM_DAILY_LIMIT=100
# Groq alternative (free tier available; takes priority over Anthropic if both set):
# GROQ_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile   # verify current model name in Groq console
# LLM_MAX_CHARS=20000
# Optional visual fallback (backend only; NEVER use a VITE_/frontend variable for this):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# VISUAL_MAX_SECONDS=480
# VISUAL_FPS=0.5
# VISUAL_DAILY_LIMIT=30
# VISUAL_PER_IP_HOUR=3
# VISUAL_TIMEOUT=90
# Real Swiggy Instamart (local testing). No token to paste: you sign in via Swiggy's OAuth page.
# INSTAMART_MODE=swiggy
# SWIGGY_REDIRECT_URI=http://localhost:8000/api/swiggy/callback
# FRONTEND_URL=http://localhost:3000
# Ordering is always off: the app only fills the cart (checkout/payment are blocked in code)
ORDER_MODE=false
ALLOW_REAL_ORDER_PLACEMENT=false
# Live Swiggy is the default. Use INSTAMART_MODE=local only for the clearly-labelled demo catalog (no real prices).
